#!/bin/bash
# Double-click this file on a Mac to install (or update) and open Lead Role.
# If macOS says it can't be opened: right-click the file, choose Open, then Open again.
clear
echo "Installing Lead Role. This window will show progress; the app opens in your browser when ready."
echo
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/faizanumer1111-pixel/Face/claude/practical-einstein-7yvfy4/mac_install.sh)"
echo
echo "You can close this window."
